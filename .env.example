# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo usado pelo agente
AGENT_MODEL=claude-opus-5-5

# Provedor alternativo compatível com a API da Anthropic (opcional). Ex.: OpenRouter, para testar com
# modelos gratuitos: AGENT_BASE_URL=https://openrouter.ai/api, AGENT_AUTH_TOKEN=sk-or-...,
# AGENT_MODEL=<modelo :free com suporte a ferramentas>. Vazio = API da Anthropic (ANTHROPIC_API_KEY).
AGENT_BASE_URL=
AGENT_AUTH_TOKEN=

# Pasta onde o agente pode criar e editar arquivos e rodar comandos
AGENT_WORKDIR=./workspace

# Teto de gasto por conversa, em dólares (o agente para ao atingir)
AGENT_MAX_BUDGET_USD=2.00

# Máximo de passos (chamadas de ferramenta) por pedido
AGENT_MAX_TURNS=40

# Porta da interface web de testes (agente-web), só em 127.0.0.1
AGENT_WEB_PORT=8000

# Minutos que o agente espera você resolver algo (CAPTCHA, código 2FA, login) antes de seguir sem isso
AGENT_HELP_TIMEOUT_MIN=10

# Fuso horário da agenda (lembretes, tarefas recorrentes, resumo diário)
AGENT_TIMEZONE=America/Sao_Paulo

# Hora do resumo diário (HH:MM). Deixe vazio para desligar.
AGENT_DAILY_SUMMARY=07:00

# Navegador próprio invisível (true) ou com janela (false). No computador, deixe false:
# é na janela dele que você resolve CAPTCHA e login. Na VPS sem tela, true.
AGENT_BROWSER_HEADLESS=false

# Endereço público da VM (https://seu-dominio). Os avisos de login expirado levam um link para a tela
# remota do navegador com este domínio. Vazio: o link só abre na própria máquina (ou pelo túnel SSH).
# O provisionar.sh preenche sozinho quando recebe --dominio.
AGENT_PUBLIC_URL=

# De quantos em quantos minutos conferir se os sistemas de empresa/sistemas.toml continuam logados.
AGENT_ACESSOS_MIN=60

# Pasta da empresa que o atendente atende (empresa.toml, catalogo.csv, faq.md, politicas.md).
# Vazio: usa empresa/ do projeto, ou a empresa fictícia de exemplos/empresa/ se ela não existir.
AGENT_EMPRESA_DIR=

# Pasta das planilhas da loja para a gestão (vendas.csv, despesas.csv, estoque.csv, caixa.csv).
# Vazio: usa dados/ do projeto, ou as planilhas fictícias de exemplos/dados/ se ela não existir.
AGENT_DADOS_DIR=

# Máximo de passos do atendente por mensagem de cliente
AGENT_ATENDENTE_MAX_TURNS=12

# true: números fora de WHATSAPP_ALLOWED_NUMBERS (clientes) falam com o atendente e recebem retomadas automáticas.
# Ligue só com a pasta empresa/ revisada.
AGENT_ATENDENTE_WHATSAPP=false

# WhatsApp: "meta" (API oficial) ou "uazapi" (não oficial, para testes). Vazio: uazapi se UAZAPI_URL
# estiver preenchida, senão meta. Passo a passo em docs/whatsapp.md.
WHATSAPP_PROVEDOR=

# UAZAPI: endereço do servidor, token da instância e um segredo longo e aleatório que vai no caminho do
# webhook. Depois de preencher e com o agente no ar num endereço público: agente-uazapi https://seu-endereco
UAZAPI_URL=
UAZAPI_TOKEN=
UAZAPI_WEBHOOK_SEGREDO=

# Número próprio do atendente (outra instância UAZAPI, no mesmo servidor). Preenchido, os clientes falam com o
# atendente por este número e o número acima fica só para o maestro (dono e equipe; outros são ignorados).
# Cadastre o webhook com: agente-uazapi --atendente https://seu-endereco
UAZAPI_ATENDENTE_TOKEN=
UAZAPI_ATENDENTE_WEBHOOK_SEGREDO=

# Áudio do WhatsApp vira texto. Com OPENAI_API_KEY: Whisper, feito pela UAZAPI (~US$ 0,006/min).
# Sem ela, com OPENROUTER_API_KEY (ou o AGENT_AUTH_TOKEN do OpenRouter): um modelo que ouve áudio,
# AGENT_TRANSCRICAO_MODELO (padrão google/gemini-2.5-flash-lite, ~US$ 0,001/min). false desliga.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AGENT_TRANSCRICAO_MODELO=
AGENT_TRANSCREVER_AUDIO=true

# Meta (API oficial): só liga quando as cinco primeiras estão preenchidas.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Números da equipe com DDI, só dígitos (ex.: 5511999990000). Vários: separe por vírgula; o primeiro é o dono.
# Vale para a Meta e para a UAZAPI: quem está aqui fala com o operador; o resto, com o atendente.
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_API_VERSION=v26.0
