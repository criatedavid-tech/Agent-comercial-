# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo usado pelo agente
AGENT_MODEL=claude-opus-5-5

# Pasta onde o agente pode criar e editar arquivos e rodar comandos
AGENT_WORKDIR=./workspace

# Teto de gasto por conversa, em dólares (o agente para ao atingir)
AGENT_MAX_BUDGET_USD=2.00

# Máximo de passos (chamadas de ferramenta) por pedido
AGENT_MAX_TURNS=40

# Porta da interface web de testes (agente-web), só em 127.0.0.1
AGENT_WEB_PORT=8000

# Minutos que o agente espera você resolver algo (CAPTCHA, código 2FA, login) antes de seguir sem isso
AGENT_HELP_TIMEOUT_MIN=10

# Fuso horário da agenda (lembretes, tarefas recorrentes, resumo diário)
AGENT_TIMEZONE=America/Sao_Paulo

# Hora do resumo diário (HH:MM). Deixe vazio para desligar.
AGENT_DAILY_SUMMARY=07:00

# Navegador próprio invisível (true) ou com janela (false). No computador, deixe false:
# é na janela dele que você resolve CAPTCHA e login. Na VPS sem tela, true.
AGENT_BROWSER_HEADLESS=false

# WhatsApp (API oficial da Meta). Passo a passo em docs/whatsapp.md.
# Só liga quando as cinco primeiras estão preenchidas.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Seu número com DDI, só dígitos (ex.: 5511999990000). Vários: separe por vírgula; o primeiro é o dono.
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_API_VERSION=v26.0
