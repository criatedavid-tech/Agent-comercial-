# HTTPS automático (Let's Encrypt) para o webhook do WhatsApp.
# O provisionar.sh troca DOMINIO_AQUI pelo seu domínio e instala em /etc/caddy/Caddyfile.
#
# Só o webhook e a tela remota do navegador ficam públicos. Painel, chat e APIs NÃO são expostos:
# acesse pela VPS com um túnel SSH (ssh -L 8000:127.0.0.1:8000 usuario@vps e abra http://127.0.0.1:8000).
# A tela remota (login nos sistemas da loja) só abre com o link temporário que o agente manda no aviso.
DOMINIO_AQUI {
	encode gzip

	handle /whatsapp/webhook {
		reverse_proxy 127.0.0.1:8000
	}

	handle /acesso-navegador/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /ws/acesso-navegador/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		respond "Not found" 404
	}

	log {
		output file /var/log/caddy/agente.log
	}
}
